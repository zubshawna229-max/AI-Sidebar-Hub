{
  "manifest_version": 3,
  "name": "AI Sidebar Hub",
  "description": "Open a right-side AI task hub on any webpage and send page context to popular AI web apps.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "AI Sidebar Hub",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ]
}
